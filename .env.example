# Copy this file to `.env` and fill in your values.

# Your xAI API key with Grok Imagine access (https://console.x.ai).
XAI_API_KEY=

# Optional overrides (defaults shown):
# XAI_BASE_URL=https://api.x.ai
# GROK_VIDEO_MODEL=grok-imagine-video
# MAX_UPLOAD_BYTES=15728640
# XAI_TIMEOUT=60

# Set to 1 to force mock mode (serve a sample clip, no API calls / no credits).
# When XAI_API_KEY is empty, mock mode turns on automatically.
# GROK_MOCK=0
